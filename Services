#include <iostream>
#include <string>
using namespace std;

int main()
{
    int category, choice, quantity, people, price;
    int total = 0;
    string concern;
    bool running = true;

    const int maxRooms = 5;

    while (running)
    {
        cout << "\n\n             Welcome to";
        cout << "\n          Brandons' Oasis";
        cout << "\n\n***************************************";
        cout << "\n          CHOOSE SERVICE";
        cout << "\n***************************************";
        cout << "\n1. ROOM BOOKING";
        cout << "\n2. ROOM CLEANING";
        cout << "\n3. PAYMENT SYSTEM";
        cout << "\n4. CUSTOMER SERVICE";
        cout << "\n5. EXIT";
        cout << "\n***************************************";
        cout << "\nEnter Category (1-5): ";
        cin >> category;

        switch (category)
        {
            // ROOM BOOKING
            case 1:
            {
                int capacity;

                cout << "\n\n******** ROOM BOOKING ********";
                 cout << "\nALL THE ROOMS HAVE A LIMIT OF 5"; 
                 cout << endl; 
                cout << "\n1. Standard Room - ₱1299 (2 PAX)";
                cout << "\n2. Deluxe Room - ₱2499 (6 PAX)";
                cout << "\n3. Suite Room - ₱3350 (8 PAX)";
                cout << "\n4. Back to Main Menu";
                cout << "\n\nEnter Room Type (1-4): ";
                cin >> choice;

                if (choice == 4)

                
                    break;

                if (choice == 1)
                {
                    price = 1299;
                    capacity = 2;
                }
                else if (choice == 2)
                {
                    price = 2499;
                    capacity = 6;
                }
                else if (choice == 3)
                {
                    price = 3350;
                    capacity = 8;
                }
                else
                {
                    cout << "\nInvalid room choice!";
                    break;
                }

                cout << "\nEnter Number of Rooms: ";
                cin >> quantity;

                if (quantity <= 0)
                {
                    cout << "\nInvalid number of rooms!";
                }
                else if (quantity > maxRooms)
                {
                    cout << "\nRoom booking limit exceeded!";
                    cout << "\nMaximum number of rooms allowed: "
                         << maxRooms;
                }
                else
                {
                    cout << "Enter Total Number of People: ";
                    cin >> people;

                    int maxPeople = quantity * capacity;

                    if (people <= 0)
                    {
                        cout << "\nInvalid number of people!";
                    }
                    else if (people > maxPeople)
                    {
                        cout << "\nNumber of people exceeded!";
                        cout << "\nMaximum capacity for "
                             << quantity << " room(s): "
                             << maxPeople << " people.";
                    }
                    else
                    {
                        int cost = price * quantity;

                        total += cost;

                        cout << "\nRoom booking successful!";
                        cout << "\nRoom Type: ";

                        if (choice == 1)
                            cout << "Standard Room";
                        else if (choice == 2)
                            cout << "Deluxe Room";
                        else
                            cout << "Suite Room";

                        cout << "\nNumber of Rooms: " << quantity;
                        cout << "\nTotal People: " << people;
                        cout << "\nMaximum Capacity: "
                             << maxPeople << " people";
                        cout << "\nBooking Cost: P" << cost;
                    }
                }
                break;
            }

            // ROOM CLEANING
            case 2:
                cout << "\n\n******** ROOM CLEANING ********";
                cout << "\nCleaning Service Fee: ₱330";
                cout << "\n!! This will add an additional fee !!";
                cout << "\n\n1. Add Cleaning Service";
                cout << "\n2. Back to Main Menu";
                cout << "\nChoose: ";
                cin >> choice;

                if (choice == 1)
                {
                    total += 330;
                    cout << "\nCleaning service added!";
                }
                else if (choice == 2)
                {
                    cout << "\nReturning to Main Menu...";
                }
                else
                {
                    cout << "\nInvalid cleaning choice!";
                }
                break;

            // PAYMENT SYSTEM
            case 3:
                cout << "\n\n******** PAYMENT SYSTEM ********";
                cout << "\nCurrent Total: ₱" << total;

                if (total > 0)
                {
                    cout << "\n\n1. Cash";
                    cout << "\n2. Credit/Debit Card";
                    cout << "\n3. Online Payment";
                    cout << "\n\nChoose Payment Method: ";
                    cin >> choice;

                    if (choice >= 1 && choice <= 3)
                    {
                        cout << "\nPayment method selected!";
                    }
                    else
                    {
                        cout << "\nInvalid payment method!";
                    }
                }
                else
                {
                    cout << "\nNo orders yet!";
                }
                break;

            // CUSTOMER SERVICE
            case 4:
                cout << "\n\n******** CUSTOMER SERVICE ********";
                cout << "\n1. Ask a Question";
                cout << "\n2. Make a Complaint";
                cout << "\n3. Request Assistance";
                cout << "\n4. Report a Room Problem";
                cout << "\n5. Billing Concern";
                cout << "\n6. Lost and Found";
                cout << "\n7. Request Room Service";
                cout << "\n8. General Inquiry";
                cout << "\n\nChoose an option: ";
                cin >> choice;

                if (choice >= 1 && choice <= 8)
                {
                    cin.ignore(1000, '\n');

                    cout << "\nPlease type your concern: ";
                    getline(cin, concern);

                    cout << "\nYour request has been recorded!";
                    cout << "\nYour Concern: " << concern;
                }
                else
                {
                    cout << "\nInvalid customer service option!";
                }
                break;

            // EXIT
            case 5:
                cout << "\n\n***************************************";
                cout << "\n Thank you for visiting Brandons' Oasis!";
                cout << "\n Final Total: ₱" << total;
                cout << "\n Goodbye!";
                cout << "\n***************************************";
                running = false;
                break;

            default:
                cout << "\nInvalid category! Please choose 1-5.";
        }

        if (running && category != 4)
        {
            cout << "\n\n***************************************";
            cout << "\nCURRENT TOTAL: ₱" << total;
            cout << "\n***************************************";
        }
    }

    return 0;
}
